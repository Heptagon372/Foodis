# 복사해서 사용: cp .env.example .env.local   (11 문서 §9, 09 문서 §8 키 발급 체크리스트)

# ── 공개 (클라이언트 번들에 포함됨)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM (푸디 답변·의도 분류·사진 인식) — docs/design/09_AI_제공자_구성_v2.md
LLM_PROVIDERS=gemini,openai            # 시도 순서. 키 없는 건 건너뛰고 장애면 다음으로. anthropic 은 넣을 때만 (예: gemini,openai,anthropic)
GEMINI_API_KEY=                        # Google AI Studio 키 (1순위 LLM, EMBED_PROVIDER=gemini 일 때 임베딩)
LLM_GEMINI_FAST=gemini-3.5-flash-lite  # 의도 분류 · 사진 인식
LLM_GEMINI_SMART=gemini-3.5-flash-lite # 답변 생성 (더 풍부하게: gemini-3.6-flash — 약 2배 비용)
LLM_GEMINI_VISION=                     # 비우면 FAST
LLM_GEMINI_FAST_THINKING=minimal       # minimal | low | medium | high — 3.7·3.8 Flash 처럼 minimal 이 없는 모델은 자동으로 low
LLM_GEMINI_SMART_THINKING=minimal
LLM_OPENAI_FAST=gpt-6-luna             # (키는 아래 OPENAI_API_KEY 를 같이 쓴다)
LLM_OPENAI_SMART=gpt-6-luna
LLM_OPENAI_VISION=
LLM_OPENAI_FAST_EFFORT=none            # none | minimal | low | medium | high — Sol·Astra 는 자동으로 low
LLM_OPENAI_SMART_EFFORT=none
ANTHROPIC_API_KEY=                     # 선택 (LLM_PROVIDERS 에 anthropic 을 넣을 때만)
LLM_ANTHROPIC_FAST=claude-haiku-4-5    # 예전 LLM_MODEL_FAST · LLM_MODEL_SMART · LLM_SMART_EFFORT 이름도 읽는다
LLM_ANTHROPIC_SMART=claude-sonnet-5
LLM_ANTHROPIC_SMART_EFFORT=low

OPENAI_API_KEY=                        # 2순위 LLM · 임베딩 · STT fallback · TTS 후보
# ── 임베딩: 제공자를 바꾸면 어드민 "임베딩 전체 다시 만들기" 필수 (질의·문서 벡터가 같은 모델이어야 한다)
# 데이터 파이프라인(foodis-data s09)도 같은 이름을 읽는다 (DATA_EMBED_PROVIDER 가 비면 EMBED_PROVIDER)
EMBED_PROVIDER=openai                  # openai | gemini (gemini 면 GEMINI_API_KEY)
# EMBEDDING_MODEL 을 비우면 제공자 기본: openai → text-embedding-3-small · gemini → gemini-embedding-2 (1536차원으로 받음).
# 제공자와 어긋나면(gemini + text-embedding-3-small 등) 벡터 검색을 끄고 로그에 경고한다
EMBEDDING_MODEL=
STT_MODEL=gpt-transcribe               # keywords 힌트 지원 모델

TTS_PROVIDER=google                    # google | openai (P3 측정 후 결정)
GOOGLE_TTS_CREDENTIALS_JSON=           # 서비스 계정 JSON 한 줄
GOOGLE_TTS_VOICE=ko-KR-Wavenet-A
OPENAI_TTS_VOICE=coral

KAKAO_REST_API_KEY=                    # Phase 3
DAILY_BUDGET_USD=5
ADMIN_EMAILS=                          # 어드민 전체 권한 메일(쉼표 구분). 나머지는 admin_roles 테이블로
DEMO_MODE=false
