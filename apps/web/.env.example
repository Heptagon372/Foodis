# 복사해서 사용: cp .env.example .env.local   (11 문서 §9, 09 문서 §8 키 발급 체크리스트)

# ── 공개 (클라이언트 번들에 포함됨)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=

LLM_PROVIDER=anthropic
LLM_MODEL_FAST=claude-haiku-4-5        # 의도 분류
LLM_MODEL_SMART=claude-sonnet-5        # 답변 생성 (같은 가격의 claude-sonnet-5-5 로 교체 가능)
LLM_SMART_EFFORT=low                   # low | medium | high — 지연 예산 1.5초 기준으로 측정 후 조정
ANTHROPIC_API_KEY=

OPENAI_API_KEY=                        # 임베딩 · STT fallback · TTS 후보
EMBEDDING_MODEL=text-embedding-3-small # 1536차원 — DB vector(1536) 과 반드시 일치
STT_MODEL=gpt-transcribe               # keywords 힌트 지원 모델

TTS_PROVIDER=google                    # 기본 체인 1순위: google | openai | gemini | elevenlabs | clova (P3 측정 후 결정)
GOOGLE_TTS_CREDENTIALS_JSON=           # 서비스 계정 JSON 한 줄
GOOGLE_TTS_VOICE=ko-KR-Wavenet-A
OPENAI_TTS_VOICE=coral
# 목소리 카탈로그 (docs/design/11_목소리_카탈로그.md) — 키가 있는 제공자의 목소리만 고를 수 있다
GEMINI_API_KEY=                        # Gemini TTS (aistudio.google.com 키)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts  # 또는 gemini-3.8-flash-lite-tts (더 저렴)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_IDS=                  # 선택: Talia=voice_id,Darian=voice_id (비우면 이름으로 찾음)
CLOVA_VOICE_KEY_ID=                    # NCP CLOVA Voice Premium — Client ID (월 기본료 주의)
CLOVA_VOICE_KEY=                       # Client Secret

KAKAO_REST_API_KEY=                    # Phase 3
DAILY_BUDGET_USD=5
ADMIN_EMAILS=                          # 어드민 전체 권한 메일(쉼표 구분). 나머지는 admin_roles 테이블로
DEMO_MODE=false
