# 복사해서 사용: cp .env.example .env.local   (11 문서 §9, 09 문서 §8 키 발급 체크리스트)

# ── 공개 (클라이언트 번들에 포함됨)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM (푸디 답변·의도 분류·사진 인식) — docs/design/09_AI_제공자_구성_v2.md
LLM_PROVIDERS=gemini,openai            # 시도 순서. 키 없는 건 건너뛰고 장애면 다음으로. anthropic 은 넣을 때만 (예: gemini,openai,anthropic)
GEMINI_API_KEY=                        # Google AI Studio 키 — LLM 1순위 · Gemini 임베딩 · STT · Gemini TTS 공용
LLM_GEMINI_FAST=gemini-3.5-flash-lite  # 의도 분류 · 사진 인식
LLM_GEMINI_SMART=gemini-3.5-flash-lite # 답변 생성 (더 풍부하게: gemini-3.6-flash — 약 2배 비용)
LLM_GEMINI_VISION=                     # 비우면 FAST
LLM_GEMINI_FAST_THINKING=minimal       # minimal | low | medium | high — 3.7·3.8 Flash 처럼 minimal 이 없는 모델은 자동으로 low
LLM_GEMINI_SMART_THINKING=minimal
LLM_OPENAI_FAST=gpt-6-luna             # (키는 아래 OPENAI_API_KEY 를 같이 쓴다)
LLM_OPENAI_SMART=gpt-6-luna
LLM_OPENAI_VISION=
LLM_OPENAI_FAST_EFFORT=none            # none | minimal | low | medium | high — Sol·Astra 는 자동으로 low
LLM_OPENAI_SMART_EFFORT=none
ANTHROPIC_API_KEY=                     # 선택 (LLM_PROVIDERS 에 anthropic 을 넣을 때만)
LLM_ANTHROPIC_FAST=claude-haiku-4-5    # 예전 LLM_MODEL_FAST · LLM_MODEL_SMART · LLM_SMART_EFFORT 이름도 읽는다
LLM_ANTHROPIC_SMART=claude-sonnet-5
LLM_ANTHROPIC_SMART_EFFORT=low

OPENAI_API_KEY=                        # 2순위 LLM · 임베딩 · STT fallback · TTS 후보
# ── 임베딩: 제공자를 바꾸면 어드민 "임베딩 전체 다시 만들기" 필수 (질의·문서 벡터가 같은 모델이어야 한다)
# 데이터 파이프라인(foodis-data s09)도 같은 이름을 읽는다 (DATA_EMBED_PROVIDER 가 비면 EMBED_PROVIDER)
EMBED_PROVIDER=openai                  # openai | gemini (gemini 면 GEMINI_API_KEY)
# EMBEDDING_MODEL 을 비우면 제공자 기본: openai → text-embedding-3-small · gemini → gemini-embedding-2 (1536차원으로 받음).
# 제공자와 어긋나면(gemini + text-embedding-3-small 등) 벡터 검색을 끄고 로그에 경고한다
EMBEDDING_MODEL=
STT_MODEL=gpt-transcribe               # keywords 힌트 지원 모델

# ── 서버 STT 체인 (사투리·외국어, docs/design/10_음성_인식_사투리_다국어.md). 키 없는 엔진은 건너뛴다
STT_KO=elevenlabs,clova,gemini,openai  # 한국어(사투리 포함) 순서
STT_MULTI=elevenlabs,gemini,openai     # 언어 자동 감지(외국어) 순서
ELEVENLABS_API_KEY=                    # ElevenLabs — Scribe v2 STT(사투리·외국어) · TTS 목소리 공용
STT_ELEVENLABS_MODEL=scribe_v2
CLOVA_SPEECH_SECRET=                   # NCP CLOVA Speech 도메인 Secret Key (단문 인식, 한국어 전용)
CLOVA_SPEECH_STT_URL=                  # 비우면 https://clovaspeech-gw.ncloud.com/recog/v1/stt
# (GEMINI_API_KEY 는 위와 같은 키 — STT 받아 적기·Gemini TTS 에도 쓰임)
STT_GEMINI_MODEL=gemini-2.5-flash
STT_NORMALIZE=true                     # 사투리·외국어면 LLM(빠른 등급)으로 표준어 문장 만들기

TTS_PROVIDER=google                    # 기본 체인 1순위: google | openai | gemini | elevenlabs | clova (P3 측정 후 결정)
GOOGLE_TTS_CREDENTIALS_JSON=           # 서비스 계정 JSON 한 줄
GOOGLE_TTS_VOICE=ko-KR-Wavenet-A
OPENAI_TTS_VOICE=coral
# 목소리 카탈로그 (docs/design/11_목소리_카탈로그.md) — 키가 있는 제공자의 목소리만 고를 수 있다
# (GEMINI_API_KEY 는 위와 같은 키 — STT 받아 적기·Gemini TTS 에도 쓰임)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts  # 또는 gemini-3.8-flash-lite-tts (더 저렴)
# (ELEVENLABS_API_KEY 는 위와 같은 키 — TTS 목소리에도 쓰임)
ELEVENLABS_VOICE_IDS=                  # 선택: Talia=voice_id,Darian=voice_id (비우면 이름으로 찾음)
CLOVA_VOICE_KEY_ID=                    # NCP CLOVA Voice Premium — Client ID (월 기본료 주의)
CLOVA_VOICE_KEY=                       # Client Secret

KAKAO_REST_API_KEY=                    # Phase 3
DAILY_BUDGET_USD=5
ADMIN_EMAILS=                          # 어드민 전체 권한 메일(쉼표 구분). 나머지는 admin_roles 테이블로
DEMO_MODE=false

# ── 지도·음식점 "한국에서 맛보기" (docs/design/12_한국에서_맛보기_지도.md — 발급 방법·약관·비용)
# KAKAO_REST_API_KEY (위 Phase 3 항목) — 서버 전용 · 카카오 로컬 API(키워드·주소 검색). 없으면 /taste 가 "지도 키 설정 필요"
NEXT_PUBLIC_MAP_PROVIDER=kakao         # kakao | naver — 지도 그리기 제공자 (검색은 항상 카카오)
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=          # 공개 · 카카오 JavaScript 키. 콘솔에 사이트 도메인(http://localhost:3000 등) 등록 필수
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=       # 공개 · NCP Maps Client ID (ncpKeyId). PROVIDER=naver 일 때만
GOOGLE_MAPS_API_KEY=                   # 선택 · 서버 전용 · Places API (New) 평점 — "맛있는 순"(지도 없는 목록)에서만 호출
GOOGLE_PLACES_DAILY_CAP=100            # Google 호출 하루 상한 (서버 인스턴스별)
FTC_FRANCHISE_API_KEY=                 # 선택 · 서버 전용 · 공공데이터포털 공정위 가맹정보 서비스키(Decoding) — 어드민 동기화
