# ── 수집 스크립트 공통
# Wikimedia 정책: 연락처가 들어간 User-Agent 필수 (없으면 403/429, 분당 10회로 제한됨)
FOODIS_USER_AGENT="FoodisDataBot/0.1 (SKHU IT contest project; your-email@example.com)"

# ── s03 (선택) TheMealDB: 개발·교육용 테스트 키 1. 상용화 시 Patreon 키로 교체
THEMEALDB_KEY=1

# ── s05 LLM 초안 (scripts/llm.py) — 고른 제공자의 키 하나만 있으면 된다
# gemini(기본) | openai | anthropic
DATA_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY 는 아래 임베딩 칸과 같이 쓴다
ANTHROPIC_API_KEY=
# 모델을 바꿀 때만 (비우면 기본값). draft: gemini-3.5-flash-lite · gpt-6-luna · claude-haiku-4-5
DATA_LLM_MODEL=
# --smart 로 쓸 모델. 기본: gemini-3.8-flash · gpt-6.1-sol · claude-sonnet-5
DATA_LLM_MODEL_SMART=
# flex = Gemini·OpenAI Flex 처리(표준의 50%, 느리고 가끔 503 → 자동 재시도). 비우면 표준
DATA_LLM_SERVICE_TIER=
# low | medium | high — 생각(thinking/reasoning) 양. 비우면 모델 기본값. 생각 토큰도 출력 요금으로 청구됨
DATA_LLM_EFFORT=

# ── s08 적재 / s09 임베딩 (Supabase: Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
# service_role 키는 서버·로컬 스크립트 전용. 절대 프론트엔드/깃에 올리지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# ── s09 임베딩 — 앱(apps/web)의 EMBED_PROVIDER · EMBEDDING_MODEL 과 반드시 같게 (다르면 검색이 조용히 망가짐)
# openai(기본) | gemini. 비우면 EMBED_PROVIDER 를 따른다
DATA_EMBED_PROVIDER=openai
OPENAI_API_KEY=
# 비우면 제공자 기본값: openai=text-embedding-3-small, gemini=gemini-embedding-2 (둘 다 1536차원으로 저장)
EMBEDDING_MODEL=
